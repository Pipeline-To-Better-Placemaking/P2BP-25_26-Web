# Comma-separated browser origins allowed by CORS
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Supabase project JWT secret (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=change-me
# All file access is confined under this directory
DATA_ROOT=/srv/p2bp-data


# Shared with the Express API
WORKSTATION_TICKET_SECRET=change-me
# Optional: only accept tickets for this project id
AMC_PROJECT_ID=
# Install root holding installer.conf and bin/amc
MV3DT_INSTALL_DIR=/opt/mv3dt
# Hostname the user's browser uses to reach this machine (default: MagicDNS name from tailscale)
AMC_PUBLIC_HOST=

AMC_USE_SUDO=1
