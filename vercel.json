{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix BetterPlacemaking.SERVER.EXPRESS ci && npm --prefix BetterPlacemaking.CLIENT.REACT ci",
  "buildCommand": "npm --prefix BetterPlacemaking.CLIENT.REACT run build",
  "outputDirectory": "BetterPlacemaking.CLIENT.REACT/dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "BetterPlacemaking.SERVER.EXPRESS/{src,node_modules}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/health", "destination": "/api/index.ts" },
    { "source": "/((?!api/|health).*)", "destination": "/index.html" }
  ]
}
