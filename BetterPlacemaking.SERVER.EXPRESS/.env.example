# Copy to .env and fill in values for local development.
# On Vercel set these in Project Settings > Environment Variables (see docs/DEPLOY.md).

# --- Server ---
PORT=5200
NODE_ENV=development

# --- Database (Supabase Postgres) ---
# Pooled connection (Supavisor, port 6543, transaction mode). Used by the app at runtime. SECRET.
DATABASE_URL=
# Direct connection (port 5432). Used only for running migrations / drizzle-kit. SECRET.
DATABASE_DIRECT_URL=

# --- Supabase Storage ---
SUPABASE_URL=
# Server-only key, bypasses RLS. SECRET - never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Workstation integration (skeleton, optional) ---
WORKSTATION_MODE=disabled
WORKSTATION_BASE_URL=
# SECRET
WORKSTATION_API_TOKEN=

# --- JWT (access tokens) ---
# Required. HMAC signing key for user access tokens - keep this secret.
JWT_KEY=
JWT_ISSUER=BetterPlacemaking
JWT_AUDIENCE=BetterPlacemaking.Client
JWT_EXPIRES_MINUTES=60

# --- Refresh tokens ---
# Optional - falls back to JWT_KEY if unset.
AUTH_REFRESH_TOKEN_HASH_KEY=
AUTH_REFRESH_TOKEN_DAYS=30
# Optional - overrides JWT_EXPIRES_MINUTES if set.
AUTH_ACCESS_TOKEN_MINUTES=

# --- CORS ---
# Comma-separated list of allowed origins. Same-origin Vercel deploys do not need it
# (leave empty); set it for local dev against a separate Vite server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base URLs (used to build links in emails) ---
API_BASE_URL=http://localhost:5200
APP_BASE_URL=http://localhost:5173

# --- Mailjet (transactional email) ---
MAILJET_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=lanzzhen@gmail.com
MAILJET_FROM_NAME=BetterPlacemaking

# --- Optional distributed cache for permission checks across instances ---
REDIS_URL=

# --- Tracking (filesystem paths from the offline CV pipeline, mirrors appsettings.json Tracking:*) ---
TRACKING_POSITIONS_CSV=Data/positions.csv
TRACKING_TRACKS_DIR=Data/tracks
TRACKING_OFFSET_X=0
TRACKING_OFFSET_Y=0
TRACKING_OFFSET_Z=0
TRACKING_ROTATION_ANGLE=0
TRACKING_SCALE_X=1
TRACKING_SCALE_Z=1

# --- RplidarScan (raw .xyz scan files on disk, mirrors appsettings.json RplidarScan:*) ---
# Physical calibration constants (meters, relative to the RPLidar's ceiling-mount
# height) - see src/services/rplidarService.ts for what each one means.
RPLIDAR_SCAN_DIRECTORY=Data/rplidar_scans
RPLIDAR_FLOOR_THRESHOLD=-4.3
RPLIDAR_CEILING_THRESHOLD=-1.0
RPLIDAR_CLUSTER_GRID_SIZE=0.4
RPLIDAR_MIN_CLUSTER_POINTS=10
RPLIDAR_WALL_MARGIN=0.8
RPLIDAR_SCANNER_EXCLUSION_RADIUS=2
RPLIDAR_GROUND_CONTACT_MARGIN=0.9
RPLIDAR_MAX_OBSTACLE_DIMENSION=5

# =====================================================================
# LEGACY - removed in cleanup
# Firebase / Firestore / GCS. Still required at boot until the cleanup PR
# (FIREBASE_PROJECT_ID is read by config/env.ts). On Vercel set only
# FIREBASE_PROJECT_ID to any placeholder; no service-account file is needed
# once all services use Postgres.
# =====================================================================
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=better-placemaking-vision
FIREBASE_DATABASE_ID=(default)
GCS_BUCKET_NAME=better-placemaking-vision.firebasestorage.app
GCS_URL_TTL_MINUTES=10080
