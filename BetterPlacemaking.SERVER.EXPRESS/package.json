{
  "name": "betterplacemaking-server-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-roles": "tsx scripts/seed-roles.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "delaunator": "^5.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
